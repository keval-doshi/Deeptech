# Copy to .env and fill in. Never commit real secrets.

# development | production
APP_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Public base URL (used in email links)
SITE_URL=http://127.0.0.1:5000

# Leave empty for local SQLite (instance/deeptechindia.db). Production must use PostgreSQL:
# DATABASE_URL=postgresql://deeptech:password@localhost:5432/deeptechindia
DATABASE_URL=

# Cookies: set true whenever the site is served over HTTPS (forced on in production)
SESSION_COOKIE_SECURE=false

# Rate limiting storage. Use Redis when running more than one worker.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# --- Email (SMTP). Empty MAIL_SERVER = emails are written to the log instead.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=DeeptechIndia <no-reply@deeptechindia.in>

# --- Payments ---------------------------------------------------------------
# mock     = local sandbox simulator (development only; refused in production)
# razorpay = Razorpay Orders + Checkout + Webhooks
PAYMENT_PROVIDER=mock
# Razorpay test keys from Dashboard → Settings → API Keys (use rzp_test_… until go-live is approved)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when creating the webhook (Dashboard → Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=
# Signing secret for the local mock provider
MOCK_WEBHOOK_SECRET=mock-webhook-secret

# --- Monitoring (optional)
SENTRY_DSN=

